# --- Server ---
NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/bookleaf
# Used only by `npm test`. Must be a separate database whose name ends in _test (it is wiped on every run).
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/bookleaf_test

# Session signing key. Generate one with: openssl rand -base64 48
JWT_SECRET=replace-with-a-long-random-string-of-at-least-32-characters
JWT_TTL_HOURS=12

# --- AI (server-side only; never sent to the browser) ---
# Leave the key empty or set AI_ENABLED=false to run without AI: tickets are still created,
# classified by keyword rules, and admins write replies manually.
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
AI_ENABLED=true
# Models per task. Classification is high-volume and simple; the draft is what authors read.
AI_CLASSIFY_MODEL=gemini-3.5-flash-lite
AI_DRAFT_MODEL=gemini-3.5-flash-lite

# --- Data ---
# Royalty figures in the sample dataset are a snapshot (latest activity: 1 Dec 2025).
# Payout timelines ("next payout by ...") are calculated relative to this date.
DATA_AS_OF_DATE=2026-01-15

# Demo passwords set by the seed script (see README for the full login list)
SEED_AUTHOR_PASSWORD=Author@123
SEED_ADMIN_PASSWORD=Admin@123
