{
  "name": "bookleaf-author-support",
  "version": "0.1.0",
  "private": true,
  "description": "Author Support & Communication Portal for BookLeaf Publishing",
  "workspaces": [
    "server"
  ],
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "npm run dev -w server",
    "build": "npm run build -w server",
    "start": "npm run start -w server",
    "test": "npm run test -w server",
    "typecheck": "npm run typecheck -w server",
    "db:migrate": "npm run db:migrate -w server",
    "db:deploy": "npm run db:deploy -w server",
    "db:seed": "npm run db:seed -w server",
    "db:reset": "npm run db:reset -w server"
  }
}
